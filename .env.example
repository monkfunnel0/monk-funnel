# Contact form (app/api/contact/route.ts)
# Set ONE or BOTH destinations. If neither is set, the form returns an error in production.
# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- Email via Resend (https://resend.com) ---
RESEND_API_KEY=
# Where leads are sent
CONTACT_TO_EMAIL=
# Optional. Must be a domain verified in Resend; defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# --- Google Sheets (Apps Script web app URL that appends a row from the JSON body) ---
GOOGLE_SHEETS_WEBHOOK_URL=
